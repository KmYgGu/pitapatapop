--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9675c7014f95bed418c3472e722d9e13, type: 3}
  m_Name: 1.Rabrith
  m_EditorClassIdentifier: 
  spine: {fileID: 11400000, guid: 5c321157c319b28419dd0bf48983c9db, type: 2}
  talkAnimation: 2.win
  portrait: {fileID: 0}
  lines:
  - trigger: 3
    message: "\uC624\uD638\uD638~ \uC800\uC758 \uBC31\uC740\uC131\uC744 \uB9C8\uC8FC\uD558\uC2DC\uC640\uC694~"
    holdSeconds: 0
    priority: 0
  - trigger: 8
    message: "\uC990\uAC70\uC6B4 \uACB0\uD22C \uC600\uC2DC\uC640\uC694~"
    holdSeconds: 0
    priority: 0
  - trigger: 9
    message: "\uC18C\uB140\uC5D0\uAC8C \uD328\uBC30\uD558\uC168\uAD70\uC694? \uB099\uB2F4\uD558\uC9C0
      \uB9C8\uC2DC\uC640\uC694~"
    holdSeconds: 0
    priority: 0
  - trigger: 2
    message: "\uC18C\uB140\uAC00 \uC0C1\uB300 \uD574\uB4DC\uB9AC\uC8E0~ \uB2E4\uAC00\uC624\uC2DC\uC640\uC694~"
    holdSeconds: 0
    priority: 0
  - trigger: 10
    message: "\uD6C4\uD6C4\u2026 \uC740\uC131\uC758 \uC8FC\uC778\uC774 \uC9C1\uC811 \uC0C1\uB300\uD574 \uC8FC\uACA0\uC2DC\uC640\uC694. \uC81C \uD568\uC815\uC5D0\u2026 \uC544\uB2C8, \uC774 \uAC8C\uC784\uC5D0 \uBE60\uC838\uBCFC\uB798\uC694?"
    holdSeconds: 0
    priority: 0
  - trigger: 10
    message: "\uC624\uB298\uC740 \uD2B9\uBCC4\uD788 \uCE74\uB4DC\uB85C \uB180\uC544\uB4DC\uB9AC\uACA0\uC2DC\uC640\uC694. \uB3C4\uB9DD\uCE58\uC9C0 \uB9C8\uC138\uC694, \uC54C\uACA0\uC8E0?"
    holdSeconds: 0
    priority: 0
  - trigger: 11
    message: "\uC5B4\uBA38\u2026 \uC774 \uC815\uB3C4\uBA74 \uAC70\uC758 \uC644\uBCBD\uD55C \uD568\uC815\uC774\uB124\uC694."
    holdSeconds: 0
    priority: 0
  - trigger: 11
    message: "\uACB0\uACFC\uB97C \uBCF4\uAC8C\uB420 \uADF8 \uD45C\uC815\uC774 \uBC8C\uC368\uBD80\uD130 \uAE30\uB300\uB418\uC2DC\uC640\uC694."
    holdSeconds: 0
    priority: 0
  - trigger: 11
    message: "\uD6C4\uD6C4\uD6C4, \uC774\uAC74 \uC81C\uAC00 \uC774\uAE30\uACA0\uB294\uB370\uC694? \uB108\uBB34 \uC27D\uAC8C \uB05D\uB098\uBC84\uB9AC\uB294 \uAC74 \uC544\uB2D0\uAE4C\uC694\u2026?"
    holdSeconds: 0
    priority: 0
  - trigger: 12
    message: "(\uADF8 \uCE74\uB4DC\u2026 \uC660\uC9C0 \uC704\uD5D8\uD560 \uC9C0\uB3C4\u2026)"
    holdSeconds: 0
    priority: 0
  - trigger: 12
    message: "\uC544\uC544\u2026 \uD639\uC2DC \uC18C\uB140\uAC00 \uB108\uBB34 \uBC29\uC2EC\uD588\uC2DC\uC640\uC694? \uB2E4\uD06C\uC11C\uD074\uC774 \uB354 \uC9C4\uD574\uC9C8 \uAC83 \uAC19\uC544\uC694\u2026"
    holdSeconds: 0
    priority: 0
  - trigger: 13
    message: "\uC624\uD638\uD638~ \uB9DE\uCDB0\uB4DC\uB9AC\uACA0\uC2DC\uC640\uC694. \uC5B4\uCC28\uD53C \uC81C \uD568\uC815\uC5D0\uC11C \uBE60\uC838\uB098\uAC08 \uC218\uB294 \uC5C6\uC744 \uD14C\uB2C8\uAE4C\uC694."
    holdSeconds: 0
    priority: 0
  - trigger: 13
    message: "\uC2B9\uB099\uD558\uACA0\uC2DC\uC640\uC694. \uC55E\uC73C\uB85C\uC758 \uC2B9\uBD80\uAC00 \uAE30\uB300\uB418\uC2DC\uC640\uC694~"
    holdSeconds: 0
    priority: 0
  - trigger: 14
    message: "\uC624\uD638\uD638~ \uC774 \uC815\uB3C4\uB85C\uB294 \uBD80\uC871\uD574\uC694. \uC870\uAE08 \uB354\u2026 \uD765\uC744 \uB192\uC774\uACA0\uC2DC\uC640\uC694~"
    holdSeconds: 0
    priority: 0
  - trigger: 14
    message: "\uC5BC\uB9C8\uB098 \uBC84\uD2F8 \uC218 \uC788\uB294\uC9C0, \uC2DC\uD5D8\uD574\uBCF4\uACE0 \uC2F6\uC0AC\uC640\uC694."
    holdSeconds: 0
    priority: 0
  - trigger: 15
    message: "\uC5B4\uBA38\uB098, \uADF8\uB7F0 \uCE74\uB4DC\uB85C \uC18C\uB140\uB97C \uC18D\uC774\uB824\uACE0\uC694? \uADC0\uC5FD\uC2DC\uC640\uC694~"
    holdSeconds: 0
    priority: 0
  - trigger: 15
    message: "\uD6C4\uD6C4\uD6C4\u2026 \uC790\uC2E0 \uC788\uB294 \uC5BC\uAD74\uC774\uC2DC\uC640\uC694"
    holdSeconds: 0
    priority: 0
  - trigger: 15
    message: "\uC774 \uC815\uB3C4\uBA74 \uCDA9\uBD84\uD560\uAC70\uB77C \uC0DD\uAC01\uD558\uC168\uB098\uC694? \uC544\uC9C1 \uC18C\uB140\uC758 \uC9C4\uC9DC \uD568\uC815\uC740 \uC2DC\uC791\uB3C4 \uC548 \uD588\uC2DC\uC640\uC694~"
    holdSeconds: 0
    priority: 0
  - trigger: 16
    message: "\uB2E4\uC774\uD558\uACA0\uC2DC\uC640\uC694. \uC544\uAE5D\uC9C0\uB9CC\u2026 \uB2E4\uC74C\uC5D4 \uB354 \uC644\uBCBD\uD55C \uCE74\uB4DC\uB85C \uB3CC\uC544\uC62C\uAC8C\uC694."
    holdSeconds: 0
    priority: 0
  - trigger: 16
    message: "\uD765\u2026 \uC9C0\uAE08\uC740 \uBB3C\uB7EC\uB098\uACA0\uC2DC\uC640\uC694. \uD558\uC9C0\uB9CC \uB3C4\uB9DD\uCE5C \uAC74 \uC544\uB2C8\uC2DC\uC640\uC694"
    holdSeconds: 0
    priority: 0
  - trigger: 17
    message: "\uC624\uD638\uD638~ \uC5ED\uC2DC~ \uC81C \uD568\uC815\uC740 \uD56D\uC0C1 \uC644\uBCBD\uD558\uC2DC\uC640\uC694~"
    holdSeconds: 0
    priority: 0
  - trigger: 17
    message: "\uC870\uAE08 \uB354 \uBD84\uBC1C\uD574\uC8FC\uC2DC\uACA0\uC5B4\uC694? \uB108\uBB34 \uC27D\uAC8C \uB05D\uB098\uBC84\uB838\uC2DC\uC640\uC694~"
    holdSeconds: 0
    priority: 0
  - trigger: 17
    message: "\uC544\uC544, \uC990\uAC70\uC6E0\uC2DC\uC640\uC694. \uB2E4\uC74C\uC5D4 \uC880 \uB354 \uBC84\uD2F0\uBA74\uC11C \uB180\uC544\uC8FC\uC138\uC694."
    holdSeconds: 0
    priority: 0
  - trigger: 18
    message: "\uC73C\uC73C\u2026 \uC774\uB7F0. \uACC4\uC0B0\uC774 \uC870\uAE08 \uD2C0\uB838\uB358 \uAC83 \uAC19\uC2DC\uC640\uC694."
    holdSeconds: 0
    priority: 0
  - trigger: 18
    message: "\uC544\uC544\u2026 \uC84C\uC2DC\uC640\uC694.. \uAE30\uC0AC\uB2D8\uC774 \uC0DD\uAC01\uBCF4\uB2E4 \uC601\uB9AC\uD558\uC2DC\uB124\uC694. \uC870\uAE08 \uBD84\uD574\uC694."
    holdSeconds: 0
    priority: 0
  - trigger: 18
    message: "\uD765\u2026 \uC774\uBC88 \uD310\uC740 \uC6B4\uC774 \uC5C6\uC5C8\uC744 \uBFD0\uC774\uC640\uC694. \uB2E4\uC74C\uC5D4 \uC808\uB300 \uC9C0\uC9C0 \uC54A\uC744 \uAC70\uC608\uC694."
    holdSeconds: 0
    priority: 0
  - trigger: 19
    message: "\uC624\uD638\uD638~ \uAC00\uC7A5 \uB0AE\uC740 \uCE74\uB4DC\uB85C \uAC00\uC7A5 \uB192\uC740 \uACB0\uACFC\uB97C \uB9CC\uB4E4\uB2E4\uB2C8. \uC5ED\uC2DC, \uC18C\uB140\uB294 \uCC9C\uC7AC\uC778 \uAC83\uC2DC\uC640\uC694~"
    holdSeconds: 0
    priority: 0
  - trigger: 19
    message: "\uC5ED\uC804\uC778 \uAC83\uC2DC\uC640\uC694! \uBC29\uAE08 \uB2F9\uC2E0 \uADF8 \uD45C\uC815\u2026 \uC815\uB9D0 \uC608\uBEE4\uC5B4\uC694. \uC624\uD638\uD638~!"
    holdSeconds: 0
    priority: 0
  - trigger: 19
    message: "\uC2EC\uC7A5\uC774 \uB450\uADFC \uAC70\uB838\uC2DC\uC640\uC694. \uC774\uB7F0 \uBC18\uC804\uC774 \uC788\uC5B4\uC11C \uAC8C\uC784\uC774 \uC7AC\uBC0C\uC2DC\uC640\uC694~"
    holdSeconds: 0
    priority: 0
  - trigger: 20
    message: "\uC544.. \uC804\uBD80\u2026 \uB2E4 \uC783\uC5B4\uBC84\uB838\uC2DC\uC640\uC694.."
    holdSeconds: 0
    priority: 0
  - trigger: 21
    message: "\uD6C4\uD6C4\u2026 \uC990\uAC70\uC6E0\uC2DC\uC640\uC694 \uB2E4\uC74C\uC5D0 \uB610 \uC774\uB7F0 \uAE30\uD68C\uAC00 \uC628\uB2E4\uBA74 \uC88B\uACA0\uC2DC\uC640\uC694."
    holdSeconds: 0
    priority: 0
  - trigger: 22
    message: "\uC544\uC9C1\uC740 \uBD80\uC871\uD55C \uAC83 \uAC19\uC2DC\uC640\uC694. \uD55C \uC7A5 \uB354 \uAC00\uC838\uC624\uACA0\uC2DC\uC640\uC694."
    holdSeconds: 0
    priority: 0
  - trigger: 22
    message: "\uC774 \uC815\uB3C4\uB85C\uB294 \uC131\uC5D0 \uCC28\uC9C0 \uC54A\uC2DC\uC640\uC694. \uC870\uAE08 \uB354\u2026 \uBC1B\uC544\uBCF4\uACA0\uC2DC\uC640\uC694"
    holdSeconds: 0
    priority: 0
  - trigger: 22
    message: "\uC6D0\uD558\uB294 \uBAA8\uC2B5\uC774 \uC544\uC9C1 \uC644\uC131\uB418\uC9C0 \uC54A\uC558\uC2DC\uC640\uC694 \uD55C \uC7A5 \uB354 \uD558\uACA0\uC2DC\uC640\uC694."
    holdSeconds: 0
    priority: 0
  - trigger: 23
    message: "\uC774\uCBE4\uC5D0\uC11C \uBA48\uCD94\uB294 \uAC8C \uD604\uBA85\uD558\uC2DC\uC640\uC694"
    holdSeconds: 0
    priority: 0
  - trigger: 23
    message: "\uC18C\uB140\uC758 \uD328\uB294\u2026 \uC774\uAC78\uB85C \uCDA9\uBD84\uD558\uC2DC\uC640\uC694."
    holdSeconds: 0
    priority: 0
  - trigger: 23
    message: "\uD6C4\uD6C4, \uC5EC\uAE30\uC11C \uBA48\uCD94\uACA0\uC2DC\uC640\uC694."
    holdSeconds: 0
    priority: 0
  - trigger: 24
    message: "\uC544\uC544\u2026 \uC774\uB7F0. \uC18C\uB140\uAC00\u2026 \uC870\uAE08 \uC695\uC2EC\uC744 \uBD80\uB838\uB098 \uBCF4\uC2DC\uC640\uC694."
    holdSeconds: 0
    priority: 0
  - trigger: 24
    message: "\uC73C\uC73C\u2026 21\uC744 \uB118\uACA8\uBC84\uB838\uC2DC\uC640\uC694. \uACC4\uC0B0\uC774 \uC0B4\uC9DD \uD2C0\uB838\uB098 \uBCF4\uC2DC\uC640\uC694\u2026"
    holdSeconds: 0
    priority: 0
  - trigger: 24
    message: "\uD765\u2026 \uC624\uB298\uC740 \uC6B4\uC774 \uC5C6\uC5C8\uC2DC\uC640\uC694. \uD558\uC9C0\uB9CC \uB2E4\uC74C\uC5D4 \uC808\uB300 \uC774\uB7EC\uC9C0 \uC54A\uACA0\uC2DC\uC640\uC694."
    holdSeconds: 0
    priority: 0
  - trigger: 25
    message: "\uD6C4\uD6C4\uD6C4\u2026 \uB531 21\uC774\uC2DC\uC640\uC694. \uC18C\uB140\uC758 \uD50C\uB808\uC774\uB294 \uC5ED\uC2DC \uC644\uBCBD\uD558\uC2DC\uC640\uC694."
    holdSeconds: 0
    priority: 0
  - trigger: 25
    message: "\uC5B4\uBA38, \uBCF4\uC138\uC694. \uC18C\uB140\uAC00 \uC815\uD655\uD788 21\uC744 \uB9CC\uB4E4\uC5C8\uC2DC\uC640\uC694. \uC774\uAC78 \uC0C1\uB300\uB97C \uD560 \uC218 \uC788\uC73C\uC2DC\uC640\uC694?"
    holdSeconds: 0
    priority: 0

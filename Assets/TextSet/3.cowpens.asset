  m_Script: {fileID: 11500000, guid: 9675c7014f95bed418c3472e722d9e13, type: 3}
  m_Name: 3.cowpens
  m_EditorClassIdentifier: 
  spine: {fileID: 11400000, guid: 3109f2ce853bf614ea971e84c363da08, type: 2}
  talkAnimation: 1.idle
  portrait: {fileID: 0}
  lines:
  - trigger: 3
    message: "\uD788\uD788, \uB0B4\uAC00 \uB530\uB4EF\uD558\uAC8C \uD574\uC904\uAED8!"
    holdSeconds: 0
    priority: 0
  - trigger: 8
    message: "\uBAA8\uB450\uAC00 \uAC74\uAC15\uD574\uC11C \uB2E4\uD589\uC774\uC57C~"
    holdSeconds: 0
    priority: 0
  - trigger: 10
    message: "\uC790, \uC2DC\uC791\uD574\uBCFC\uAE4C? \uAE34\uC7A5\uD560 \uD544\uC694\uB294 \uC5C6\uC5B4. \uADF8\uB0E5 \uAC8C\uC784\uC778\uAC78"
    holdSeconds: 0
    priority: 0
  - trigger: 11
    message: "\uC774 \uC815\uB3C4\uBA74 \uB0B4\uAC00 \uC870\uAE08 \uC720\uB9AC\uD560 \uC9C0\uB3C4 \uBAB0\uB77C. \uADF8\uB798\uB3C4 \uB108\uBB34 \uC0C1\uC2EC\uD558\uC9C0 \uB9C8. \uB0B4\uAC00 \uACFC\uD558\uAC8C \uBAB0\uC544\uBD99\uC774\uC9C4 \uC54A\uC744\uAC8C."
    holdSeconds: 0
    priority: 0
  - trigger: 12
    message: "\uC5B4\u2026? \uADF8 \uD328\uB294 \uC870\uAE08 \uAE4C\uB2E4\uB86D\uB124."
    holdSeconds: 0
    priority: 0
  - trigger: 13
    message: "\uCF5C. \uB0B4\uAC00 \uB124 \uD45C\uC815\uC744 \uACC4\uC18D \uBCF4\uACE0 \uC788\uC744\uAC8C\u2026 \uB108\uBB34 \uCD08\uC870\uD574\uD558\uC9C0 \uB9C8."
    holdSeconds: 0
    priority: 0
  - trigger: 14
    message: "\uB808\uC774\uC988\uD560\uAC8C. \uBBF8\uC548\u2026 \uC870\uAE08 \uC138\uAC8C \uB098\uAC00\uB294 \uAC83 \uAC19\uC9C0?"
    holdSeconds: 0
    priority: 0
  - trigger: 15
    message: "\uB124\uAC00 \uBC84\uD2F8 \uC218 \uC788\uC744 \uAC83 \uAC19\uC544\uC11C. \uB808\uC774\uC988 \uD560\uAED8. \uD639\uC2DC \uD798\uB4E4\uBA74 \uB9D0\uD574, \uB0B4\uAC00 \uB9DE\uCDB0\uC904\uAC8C"
    holdSeconds: 0
    priority: 0
  - trigger: 15
    message: "\uD6C4\uD6C4\u2026 \uC790\uC2E0 \uC788\uB294 \uCC99\uD574\uB3C4, \uB124 \uB208\uC774 \uC870\uAE08 \uD754\uB4E4\uB9AC\uACE0 \uC788\uC5B4"
    holdSeconds: 0
    priority: 0
  - trigger: 15
    message: "\uAD1C\uCC2E\uC544.. \uB9D0\uD558\uC9C0 \uC54A\uC544\uB3C4 \uC54C\uACE0 \uC788\uC73C\uB2C8\uAE4C\u2026 \uC5B5\uC9C0\uB85C \uC228\uAE38 \uD544\uC694 \uC5C6\uC5B4."
    holdSeconds: 0
    priority: 0
  - trigger: 16
    message: "\uC9C0\uAE08\uC740 \uC774\uB9CC \uBB3C\uB7EC\uB0A0\uAC8C. \uB124\uAC00 \uB108\uBB34 \uD798\uB4E4\uC5B4\uD558\uB294 \uAC74 \uBCF4\uACE0 \uC2F6\uC9C0 \uC54A\uC544\uC11C.."
    holdSeconds: 0
    priority: 0
  - trigger: 16
    message: "\uC5EC\uAE30\uC120 \uBB3C\uB7EC\uB098\uC57C \uD560 \uAC83 \uAC19\uC544. \uC0C1\uB300\uD558\uAE30 \uBC84\uAC70\uC6CC.."
    holdSeconds: 0
    priority: 0
  - trigger: 17
    message: "\uC774\uACBC\uB124\u2026 \uBBF8\uC548. \uC77C\uBD80\uB7EC \uADF8\uB7F0 \uAC74 \uC544\uB2CC\uB370. \uADF8\uB798\uB3C4\u2026 \uB124\uAC00 \uC9C4 \uC5BC\uAD74\uB3C4, \uB098\uB294 \uADF8\uB0E5 \uB124\uAC00 \uC5EC\uAE30 \uC788\uB2E4\uB294 \uAC8C \uC88B\uC544."
    holdSeconds: 0
    priority: 0
  - trigger: 17
    message: "\uD5E4\uD5E4.. \uC774\uBC88 \uC2B9\uB9AC\uB294 \uACE0\uB9D9\uAC8C \uBC1B\uC744\uAED8"
    holdSeconds: 0
    priority: 0
  - trigger: 18
    message: "\uB0B4\uAC00 \uC695\uC2EC\uC774 \uACFC\uD588\uB098\uBD10.. \uB2E4\uC74C \uBC88\uC5D0\uB294 \uC870\uC2EC\uD574\uC57C\uC9C0"
    holdSeconds: 0
    priority: 0
  - trigger: 18
    message: "\uC544 \uC84C\uB2E4.. \uADF8\uB798\uB3C4 \uB124\uAC00 \uC774\uAE34 \uD45C\uC815\uC774 \uC0DD\uAC01\uBCF4\uB2E4 \uBCF4\uAE30 \uC88B\uC544."
    holdSeconds: 0
    priority: 0
  - trigger: 19
    message: "\uB124\uAC00 \uC548\uC2EC\uD558\uACE0 \uC788\uC744 \uB54C, \uB0B4\uAC00 \uB4A4\uC9D1\uC5C8\uB124. \uADF8 \uB180\uB780 \uC5BC\uAD74\u2026 \uC870\uAE08 \uBBF8\uC548\uD558\uBA74\uC11C\uB3C4, \uC774\uC0C1\uD558\uAC8C \uB9C8\uC74C\uC5D0 \uB4E4\uC5B4."
    holdSeconds: 0
    priority: 0
  - trigger: 20
    message: "\uC774\uB807\uAC8C\uB098 \uC624\uB798 \uAC19\uC774 \uC788\uC5B4\uC92C\uAD6C\uB098. \uAC00\uC9C4 \uAC74 \uD558\uB098\uB3C4 \uC5C6\uAC8C \uB418\uC5C8\uC9C0\uB9CC, \uADF8\uB798\uB3C4 \uB9C8\uC74C\uC740 \uD48D\uC871\uD574\uC9C4 \uAC83 \uAC19\uC544."
    holdSeconds: 0
    priority: 0
  - trigger: 21
    message: "\uBC8C\uC368 \uAC00\uB824\uACE0? \u2026\uC870\uAE08\uB9CC \uB354 \uC788\uB2E4 \uAC00\uBA74 \uC548 \uB3FC? \uB2E4\uC74C\uC5D0\uB294 \uAF2D \uC640\uC8FC\uB294 \uAC70\uC57C? \uC57D\uC18D\uC774\uC57C."
    holdSeconds: 0
    priority: 0
  - trigger: 22
    message: "\uB354 \uD560 \uC218 \uC788\uC744 \uAC83 \uAC19\uC544. \uD55C \uBC88 \uD574\uBCFC\uAE4C.."
    holdSeconds: 0
    priority: 0
  - trigger: 22
    message: "\uB290\uB08C\uC774 \uC88B\uC544. \uB354 \uB098\uC544 \uAC08\uB798."
    holdSeconds: 0
    priority: 0
  - trigger: 22
    message: "\uC870\uAE09\uD558\uC9C0 \uC54A\uAC8C. \uCC9C\uCC9C\uD788"
    holdSeconds: 0
    priority: 0
  - trigger: 23
    message: "\uC5EC\uAE30\uAE4C\uC9C0\uB9CC \uD560\uAC8C"
    holdSeconds: 0
    priority: 0
  - trigger: 23
    message: "\uB09C \uC5EC\uAE30\uC11C \uBA48\uCDB0\uC57C \uD560 \uAC83 \uAC19\uC544."
    holdSeconds: 0
    priority: 0
  - trigger: 24
    message: "\uC544\u2026 \uB118\uC5B4\uBC84\uB838\uB124. \uD6CC\uCA4D"
    holdSeconds: 0
    priority: 0
  - trigger: 24
    message: "\uC774\uB807\uAC8C \uB418\uC5B4\uBC84\uB838\uB124, \uD750\uC73D"
    holdSeconds: 0
    priority: 0
  - trigger: 25
    message: "\uC774 \uC22B\uC790\uAC00 \uB098\uC640 \uBC84\uB838\uC5B4! \uC5B4\uB5BB\uAC8C\uD574?!"
    holdSeconds: 0
    priority: 0

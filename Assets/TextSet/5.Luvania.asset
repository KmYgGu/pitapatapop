  m_Script: {fileID: 11500000, guid: 9675c7014f95bed418c3472e722d9e13, type: 3}
  m_Name: 5.Luvania
  m_EditorClassIdentifier: 
  spine: {fileID: 0}
  talkAnimation: 1.idle
  portrait: {fileID: 0}
  lines:
  - trigger: 3
    message: "\uBC1B\uC544\uB78F~!"
    holdSeconds: 0
    priority: 0
  - trigger: 8
    message: "\uC58F\uD638~! \uC774\uACBC\uB2E4"
    holdSeconds: 0
    priority: 0
  - trigger: 10
    message: "\uC790, \uC2DC\uC791\uD558\uC790. \uB108\uBB34 \uC9C4\uC9C0\uD558\uAC8C \uD558\uC9C0 \uB9D0\uACE0, \uADF8\uB0E5 \uAC00\uBCCD\uAC8C \uC990\uAE30\uC790"
    holdSeconds: 0
    priority: 0
  - trigger: 11
    message: "\uB108\uC758 \uD328\uB97C \uBCF4\uB2C8, \uB0B4\uAC00 \uC880 \uC720\uB9AC\uD55C \uAC83 \uAC19\uC740\uB370~?"
    holdSeconds: 0
    priority: 0
  - trigger: 12
    message: "\uB108 \uC124\uB9C8 \uADF8\uAC78\uB85C \uB098 \uC774\uAE30\uB824\uACE0?"
    holdSeconds: 0
    priority: 0
  - trigger: 13
    message: "\uC77C\uB2E8 \uB9DE\uCDB0\uC904\uAC8C. \uB108\uBB34 \uC138\uAC8C \uB098\uC624\uC9C4 \uB9C8, \uBB34\uC11C\uC6B4 \uACBD\uD5D8\uC740 \uC544\uC9C1 \uACAA\uACE0 \uC2F6\uC9C0 \uC54A\uC544."
    holdSeconds: 0
    priority: 0
  - trigger: 14
    message: "\uC774\uB7F0 \uC0C1\uD669\uC740 \uC880 \uB354 \uC990\uAE30\uACE0 \uC2F6\uC740\uB370? \uB808\uC774\uC988 \uD560\uAC8C"
    holdSeconds: 0
    priority: 0
  - trigger: 15
    message: "\uBCF8\uC2EC\uC740 \uC228\uAE30\uAE30 \uD798\uB4E4\uC9C0\uB9CC \uC9C0\uAE08\uC740 \uC9C8 \uAC83 \uAC19\uC9C0\uAC00 \uC54A\uC544."
    holdSeconds: 0
    priority: 0
  - trigger: 15
    message: "\uD3B8\uD558\uAC8C \uD558\uC790\uACE0, \uC778\uC0C1 \uC4F8 \uD544\uC698 \uC5C6\uC5B4."
    holdSeconds: 0
    priority: 0
  - trigger: 16
    message: "\uC774\uBC88\uC5D4 \uC811\uC744 \uAC8C. \uAD73\uC774 \uBB34\uB9AC\uD558\uAC8C \uAC08 \uD544\uC694\uB294 \uAC83 \uAC19\uC544\uC11C."
    holdSeconds: 0
    priority: 0
  - trigger: 16
    message: "\uB2E4\uC774. \uC544\uBB34\uB9AC \uC0DD\uAC01\uD574\uB3C4 \uC774\uAE38 \uD655\uB960\uC774 \uC801\uC5B4."
    holdSeconds: 0
    priority: 0
  - trigger: 17
    message: "\uC624? \uC774\uACBC\uB2E4. \uC194\uC9C1\uD788 \uC880 \uAE30\uBD84 \uC88B\uC544."
    holdSeconds: 0
    priority: 0
  - trigger: 17
    message: "\uB108\uBB34 \uC0C1\uC2EC\uD558\uC9C4 \uB9C8 \uB2E4\uC74C\uC5D4 \uB108\uAC00 \uC774\uAE38 \uC218 \uC788\uC796\uC544."
    holdSeconds: 0
    priority: 0
  - trigger: 18
    message: "\uC544 \uC84C\uB2E4. \uD45C\uC815\uC744 \uBCF4\uB2C8 \uB10C \uBFCC\uB4EF\uD574 \uBCF4\uC778\uB2E4? \uC660\uC9C0 \uC584\uBBF8\uC6CC."
    holdSeconds: 0
    priority: 0
  - trigger: 18
    message: "\uB098\uB984 \uC5F4\uC2EC\uD788 \uD55C \uAC83 \uAC19\uC740 \uB370. \uC800\uBC84\uB838\uB124. \uC544\uC26C\uC6CC\uB77C."
    holdSeconds: 0
    priority: 0
  - trigger: 19
    message: "\uC774\uACBC\uB2E4.. \uC9C4\uC9DC \uB9CC\uC804\uC774\uC5C8\uC5B4. \uC774\uAC78 \uC774\uACA8 \uBC84\uB838\uB124."
    holdSeconds: 0
    priority: 0
  - trigger: 20
    message: "\uD558, \uC644\uC804 \uD138\uB838\uB2E4. \uB108 \uC0DD\uAC01\uBCF4\uB2E4 \uB300\uB2E8\uD558\uB2E4."
    holdSeconds: 0
    priority: 0
  - trigger: 20
    message: "\uBC11\uCC9C\uB3C4 \uC5C6\uC774 \uB2E4 \uBC14\uB2E5\uB098 \uBC84\uB838\uC5B4. \uB108\uBB34 \uC138\uAC8C \uD55C\uAC70 \uC544\uB0D0? \uB2E4\uC74C\uC5D0\uB294 \uC880 \uBD10\uC918\uB77C~"
    holdSeconds: 0
    priority: 0
  - trigger: 21
    message: "\uC624\uB298 \uC7AC\uBC0C\uC5C8\uC5B4. \uB2E4\uC74C\uC5D0 \uB610 \uD558\uC790."
    holdSeconds: 0
    priority: 0
  - trigger: 22
    message: "\uD55C \uC7A5 \uB354 \uBC1B\uC744\uAC8C. \uB108\uBB34 \uAE30\uB300\uB97C \uB9C9 \uAC78\uC9C4 \uB9C8, \uADF8\uB0E5 \uD574\uBCF4\uB294 \uAC70\uC57C"
    holdSeconds: 0
    priority: 0
  - trigger: 22
    message: "\uADF8\uB798\uB3C4 \uB2E4\uC74C \uC7A5 \uCE74\uB4DC\uB97C \uC54C\uACE0 \uC2F6\uC5B4. \uB354 \uD560\uAC8C."
    holdSeconds: 0
    priority: 0
  - trigger: 22
    message: "\uC544\uC9C1\uC740 \uC548\uC804\uD560 \uAC83 \uAC19\uC544. \uD55C \uC7A5 \uB354"
    holdSeconds: 0
    priority: 0
  - trigger: 23
    message: "\uC774 \uC815\uB3C4\uBA74 \uADF8\uB7ED\uC800\uB7ED\uC778 \uB4EF. \uC5EC\uAE30\uAE4C\uC9C0"
    holdSeconds: 0
    priority: 0
  - trigger: 23
    message: "\uB108\uB3C4 \uB124 \uC0DD\uAC01\uB300\uB85C \uD574. \uB09C \uADF8\uB0E5 \uD3B8\uD558\uAC8C \uAC08\uAC8C"
    holdSeconds: 0
    priority: 0
  - trigger: 24
    message: "\uC0DD\uAC01\uB9CC \uD588\uC744 \uBFD0\uC778\uB370, \uC9C4\uC9DC\uB85C \uB098\uC62C \uC904\uC774\uC57C. \uBD88\uD589\uD574~"
    holdSeconds: 0
    priority: 0
  - trigger: 24
    message: "\uC561\uB55C\uD588\uB2E4\uACE0 \uBC1B\uC544\uB4E4\uC5EC\uC57C\uC9C0. \uCA5D.."
    holdSeconds: 0
    priority: 0
  - trigger: 25
    message: "\uC9C4\uC9DC \uB098\uC624\uB124? \uC2E0\uAE30\uD558\uB2E4"
    holdSeconds: 0
    priority: 0

  m_Script: {fileID: 11500000, guid: 9675c7014f95bed418c3472e722d9e13, type: 3}
  m_Name: 4.Lamia
  m_EditorClassIdentifier: 
  spine: {fileID: 11400000, guid: 787f9db408e972744a03b5113e88638c, type: 2}
  talkAnimation: 1.idle
  portrait: {fileID: 0}
  lines:
  - trigger: 3
    message: "\uB450 \uB208 \uB611\uB611\uD788 \uB9C8\uC8FC\uD558\uC138\uC694!"
    holdSeconds: 0
    priority: 0
  - trigger: 8
    message: "\uC2B9\uC790\uB294 \uD56D\uC0C1 \uC900\uBE44\uB41C \uCABD\uC774\uB78D\uB2C8\uB2E4.
      \uD6C4\uD6C4\uD6C4"
    holdSeconds: 0
    priority: 0
  - trigger: 10
    message: "\uD6C4\uD6C4\u2026 \uC774\uB7F0 \uD558\uCC2E\uC740 \uAC8C\uC784\uC73C\uB85C \uC2DC\uAC04\uC744 \uBCF4\uB0B4\uAC8C \uB420 \uC904\uC740 \uBAB0\uB790\uAD70\uC694. \uC790, \uB2F9\uC2E0\uC758 \uADF8 \uC791\uC740 \uC6A9\uAE30\uB97C \uBCF4\uC5EC\uC8FC\uC2DC\uC8E0."
    holdSeconds: 0
    priority: 0
  - trigger: 10
    message: "\uD6C4\uD6C4\u2026 \uC774\uB7F0 \uC2DC\uC2DC\uD55C \uAC8C\uC784\uC5D0 \uB07C\uC5B4\uC8FC\uC2DC\uB2E4\uB2C8. \uB2F9\uC2E0\uC758 \uADF8 \uD558\uCC2E\uC740 \uC790\uC874\uC2EC, \uC624\uB298 \uC5BC\uB9C8\uB098 \uBD80\uC11C\uC9C8\uC9C0 \uAE30\uB300\uB418\uB294\uAD70\uC694."
    holdSeconds: 0
    priority: 0
  - trigger: 11
    message: "\uADF8 \uC815\uB3C4 \uD328\uB85C \uC800\uB97C \uC0C1\uB300\uD558\uACA0\uB2E4\uACE0\uC694? \u2026\uD6C4\uD6C4. \uB2F9\uC2E0 \uC5BC\uAD74\uC5D0 \uC774\uBBF8 \u2018\uD328\uBC30\u2019\uB77C\uACE0 \uC4F0\uC5EC \uC788\uC5B4\uC694."
    holdSeconds: 0
    priority: 0
  - trigger: 11
    message: "\uB2F9\uC2E0\uC758 \uD328\uB97C \uBCF4\uBA74. \uC815\uB9D0 \uD558\uCC2E\uACE0 \uCD08\uB77C\uD558\uB124\uC694. \uBD88\uC30D\uD574\uB77C"
    holdSeconds: 0
    priority: 0
  - trigger: 11
    message: "\uB2F9\uC2E0 \uBA38\uB9AC \uC704\uC5D0 \uBD99\uC5B4 \uC788\uB294 \uADF8 \uC22B\uC790, \uAF64 \uC815\uC9C1\uD558\uAD70\uC694. \uB2F9\uC2E0\uC758 \uD45C\uC815\uB9CC\uD07C\uC774\uB098\uC694."
    holdSeconds: 0
    priority: 0
  - trigger: 11
    message: "\uC548\uC4F0\uB7FD\uB124\uC694. \uB2F9\uC2E0 \uBA38\uB9AC \uC704\uC5D0 \uBD99\uC5B4 \uC788\uB294 \uCE74\uB4DC\uAC00 \uB2F9\uC2E0 \uB300\uC2E0 \uBE44\uBA85\uC744 \uC9C0\uB974\uACE0 \uC788\uB294\uB370."
    holdSeconds: 0
    priority: 0
  - trigger: 11
    message: "\uADF8 \uB208\uBE5B, \uC88B\uB124\uC694. \u2018\uD639\uC2DC \uC774\uAE38 \uC218 \uC788\uC9C0 \uC54A\uC744\uAE4C?\u2019 \uD558\uACE0 \uAE30\uB300\uD558\uACE0 \uC788\uAD70\uC694."
    holdSeconds: 0
    priority: 0
  - trigger: 12
    message: "\uC124\uB9C8 \uB2F9\uC2E0\uC774 \uC800\uB97C \uC555\uBC15\uD560 \uC218 \uC788\uC744 \uAC70\uB77C \uC0DD\uAC01\uD55C \uAC74 \uC544\uB2C8\uACA0\uC8E0? \uAC00\uC18C\uB86D\uAD70\uC694."
    holdSeconds: 0
    priority: 0
  - trigger: 12
    message: "\uB2F9\uC2E0\uC774 \uC800\uB97C \uC870\uAE08\uC774\uB77C\uB3C4 \uC704\uD611\uD560 \uC218 \uC788\uB2E4\uB294 \uCC29\uAC01, \uC870\uAE08 \uB354 \uC990\uAE30\uAC8C \uD574\uB4DC\uB9AC\uC8E0."
    holdSeconds: 0
    priority: 0
  - trigger: 12
    message: "\uD6C4\uD6C4\u2026 \uACC4\uC18D \uB208\uCE58\uB97C \uBCF4\uC138\uC694. \uB2F9\uC2E0\uC774 \uBB34\uC5C7\uC744 \uB450\uB824\uC6CC\uD558\uB294\uC9C0, \uADF8 \uC5BC\uAD74\uC774 \uC804\uBD80 \uB9D0\uD574\uC8FC\uACE0 \uC788\uC73C\uB2C8\uAE4C."
    holdSeconds: 0
    priority: 0
  - trigger: 12
    message: "\uC81C \uD45C\uC815\uC744 \uC77D\uC73C\uB824\uACE0 \uD558\uC9C0 \uB9C8\uC138\uC694. \uB2F9\uC2E0\uBCF4\uB2E4 \uC81C\uAC00 \uD45C\uC815\uC744 \uC228\uAE30\uB294 \uB370\uC5D0\uB294 \uC775\uC219\uD558\uAC70\uB4E0\uC694."
    holdSeconds: 0
    priority: 0
  - trigger: 12
    message: "\uD655\uC2E0\uC774 \uC5C6\uC73C\uC2E0 \uBAA8\uC591\uC774\uAD70\uC694. \uADF8\uB7FC \uBCA0\uD305\uC744 \uC62C\uB824\uBCF4\uC138\uC694. \uB2F9\uC2E0\uC758 \uBD88\uC548\uC774 \uC5B4\uB514\uAE4C\uC9C0 \uACAC\uB51C \uC218 \uC788\uB294\uC9C0 \uAD81\uAE08\uD558\uB2C8\uAE4C."
    holdSeconds: 0
    priority: 0
  - trigger: 13
    message: "\uC5BC\uB9C8\uB098 \uB354 \uBC1C\uBC84\uB465 \uCE60 \uC218 \uC788\uB294\uC9C0\u2026 \uCC9C\uCC9C\uD788 \uAD6C\uACBD\uD574 \uB4DC\uB9AC\uC8E0"
    holdSeconds: 0
    priority: 0
  - trigger: 13
    message: "\uC81C\uAC00 \uC9C1\uC811 \uB05D\uB0B4\uC8FC\uAE30 \uC804\uAE4C\uC9C0\uB294 \uC2A4\uC2A4\uB85C \uC790\uBA78\uD558\uB294 \uAC78 \uC6A9\uB0A9\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    holdSeconds: 0
    priority: 0
  - trigger: 13
    message: "\uC88B\uC544\uC694. \uB2F9\uC2E0\uC774 \uC5B4\uB514\uAE4C\uC9C0 \uB9DD\uAC00\uC9C8 \uC218 \uC788\uB294\uC9C0 \uC9C1\uC811 \uD655\uC778\uD574\uBCF4\uC8E0."
    holdSeconds: 0
    priority: 0
  - trigger: 13
    message: "\uC870\uC2EC\uD558\uC138\uC694. \uC9C0\uAE08\uBD80\uD130\uB294 \uCE74\uB4DC\uAC00 \uC544\uB2C8\uB77C \uB2F9\uC2E0\uC758 \uC120\uD0DD\uC774 \uB2F9\uC2E0\uC744 \uBC30\uC2E0\uD560 \uD14C\uB2C8\uAE4C."
    holdSeconds: 0
    priority: 0
  - trigger: 13
    message: "\uD6C4\uD6C4\u2026 \uADF8 \uD45C\uC815. \uC544\uC9C1 \uAE30\uB300\uD558\uACE0 \uC788\uAD70\uC694. \uC870\uAE08\uB9CC \uB354 \uAE30\uB2E4\uB9AC\uC138\uC694. \uACE7 \uADF8 \uAE30\uB300\uAC00 \uC5BC\uB9C8\uB098 \uC6B0\uC2A4\uC6E0\uB294\uC9C0 \uC54C\uB824\uB4DC\uB9B4 \uD14C\uB2C8\uAE4C."
    holdSeconds: 0
    priority: 0
  - trigger: 13
    message: "\uBA48\uCD9C \uAE30\uD68C\uB294 \uCDA9\uBD84\uD788 \uB4DC\uB838\uC2B5\uB2C8\uB2E4. \uC774\uC81C \uD130\uC9C0\uB294 \uAC74 \uB2F9\uC2E0\uC758 \uD328\uC77C\uAE4C\uC694, \uC790\uC874\uC2EC\uC77C\uAE4C\uC694?"
    holdSeconds: 0
    priority: 0
  - trigger: 14
    message: "\uC774 \uC815\uB3C4 \uC555\uBC15\uC5D0\uB3C4 \uBC84\uD2F8 \uC218 \uC788\uC744\uAE4C\uC694?"
    holdSeconds: 0
    priority: 0
  - trigger: 14
    message: "\uC790, \uC774\uC81C \uC228\uC774 \uC880 \uAC00\uBE60\uC9C0\uC2DC\uC8E0? \uD6C4\uD68C\uD55C\uB2E4\uACE0 \uD574\uB3C4 \uB2A6\uC5C8\uC5B4\uC694."
    holdSeconds: 0
    priority: 0
  - trigger: 14
    message: "\uADF8\uB798\uC694, \uC5B4\uC11C \uBC1B\uC544\uB4E4\uC774\uC138\uC694. \uB2F9\uC2E0 \uC2A4\uC2A4\uB85C \uBB34\uB364\uC744 \uD30C\uB294 \uBAA8\uC2B5\uC744 \uBCF4\uACE0 \uC2F6\uC5C8\uAC70\uB4E0\uC694."
    holdSeconds: 0
    priority: 0
  - trigger: 15
    message: "\uD6C4\uD6C4, \uC790\uC2E0 \uC788\uB294 \uCC99\uD558\uC2DC\uB294\uAD70\uC694. \uD558\uC9C0\uB9CC \uC81C \uC55E\uC5D0\uC120 \uC18C\uC6A9\uC5C6\uC2B5\uB2C8\uB2E4."
    holdSeconds: 0
    priority: 0
  - trigger: 15
    message: "\uB2F9\uC2E0 \uB208\uC740 \uC774\uBBF8 \uB3C4\uB9DD\uAC00\uACE0 \uC788\uC5B4\uC694. \uADF8 \uAC00\uC9DC \uC790\uC2E0\uAC10, \uB0B4\uAC00 \uC9C1\uC811 \uCC22\uC5B4\uBC84\uB9AC\uC8E0"
    holdSeconds: 0
    priority: 0
  - trigger: 15
    message: "\uB2F9\uC2E0\uC774 \uBBFF\uB294 \uAC74 \uC81C \uCE74\uB4DC\uAC00 \uC544\uB2C8\uB77C \uC81C \uD45C\uC815\uC774\uACA0\uC8E0. \uADF8\uB7F0\uB370\u2026 \uADF8 \uD45C\uC815\uC744 \uBBFF\uC5B4\uB3C4 \uAD1C\uCC2E\uC744\uAE4C\uC694?"
    holdSeconds: 0
    priority: 0
  - trigger: 15
    message: "\uC21C\uC9C4\uD558\uC2DC\uAD70\uC694. \uAC70\uC6B8\uC774\uB77C\uB3C4 \uC788\uB2E4\uBA74 \uB2F9\uC2E0\uC740 \uADF8 \uD45C\uC815\uC744 \uD574\uC57C\uD560 \uC0C1\uD669\uC774 \uC544\uB2C8\uB77C\uACE0 \uAE68\uB2EC\uC744 \uD150\uB370"
    holdSeconds: 0
    priority: 0
  - trigger: 16
    message: "\uC9C0\uAE08\uC740 \uAD73\uC774 \uD798\uC744 \uC4F8 \uD544\uC694\uAC00 \uC5C6\uACA0\uB124\uC694. \uB2F9\uC2E0\uC740 \uC544\uC9C1\u2026 \uB0B4 \uC0C1\uB300\uAC00 \uB418\uC9C0 \uBABB\uD574\uC694"
    holdSeconds: 0
    priority: 0
  - trigger: 16
    message: "\uB2F9\uC2E0 \uAC19\uC740 \uD558\uCC2E\uC740 \uC0C1\uB300\uC5D0\uAC8C \uD798\uC744 \uB0AD\uBE44\uD558\uACE0 \uC2F6\uC9C0 \uC54A\uAD70\uC694. \u2026\uB2E4\uC74C\uC5D0 \uC81C\uB300\uB85C \uBD80\uC234\uB4DC\uB9B4 \uD14C\uB2C8, \uADF8\uB54C\uAE4C\uC9C0 \uC0B4\uC544\uB0A8\uC73C\uC138\uC694."
    holdSeconds: 0
    priority: 0
  - trigger: 17
    message: "\uC5ED\uC2DC. \uC2B9\uC790\uB294 \uD56D\uC0C1 \uC900\uBE44\uB41C \uCABD\uC774\uC8E0."
    holdSeconds: 0
    priority: 0
  - trigger: 17
    message: "\uB2F9\uC2E0\uC740 \uCC98\uC74C\uBD80\uD130 \uC774\uAE38 \uC790\uACA9\uC774 \uC5C6\uC5C8\uC5B4\uC694. \uC6D0\uB798 \uC788\uC5B4\uC57C\uD560 \uC790\uB9AC\uB85C \uAEBC\uC9C0\uC138\uC694."
    holdSeconds: 0
    priority: 0
  - trigger: 17
    message: "\uD6C4\uD6C4\u2026 \uC81C\uAC00 \uC774\uAE34 \uAC8C \uB9DE\uB294\uB370\uB3C4 \uC870\uAE08 \uD5C8\uBB34\uD558\uB124\uC694. \uB2F9\uC2E0\uC774 \uB108\uBB34 \uC27D\uAC8C \uBB34\uB108\uC838\uBC84\uB824\uC11C."
    holdSeconds: 0
    priority: 0
  - trigger: 17
    message: "\uB2F9\uC2E0\uC774 \uC120\uD0DD\uD55C \uCE74\uB4DC\uAC00 \uB2F9\uC2E0\uC744 \uBC30\uC2E0\uD55C \uAC8C \uC544\uB2D9\uB2C8\uB2E4. \uCC98\uC74C\uBD80\uD130 \uB2F9\uC2E0\uC758 \uD310\uB2E8\uC774 \uD615\uD3B8\uC5C6\uC5C8\uB358 \uAC70\uC608\uC694."
    holdSeconds: 0
    priority: 0
  - trigger: 17
    message: "\uB2E4\uC74C \uD310\uC5D0\uC11C\uB294 \uC870\uAE08 \uC2E0\uC911\uD574\uC9C0\uC138\uC694. \uBB3C\uB860\u2026 \uB2F9\uC2E0\uC5D0\uAC8C \uADF8\uB7F0 \uB2A5\uB825\uC774 \uC788\uC744\uC9C0\uB294 \uBAA8\uB974\uACA0\uC9C0\uB9CC."
    holdSeconds: 0
    priority: 0
  - trigger: 18
    message: "\uADF8 \uAE30\uC05C \uD45C\uC815, \uC7A0\uC2DC \uBD10\uB4DC\uB9AC\uC8E0. \uB2E4\uC74C\uC5D4 \uADF8\uB807\uAC8C \uC6C3\uC744 \uC218 \uC5C6\uC744 \uD14C\uB2C8\uAE4C."
    holdSeconds: 0
    priority: 0
  - trigger: 18
    message: "\uACE0\uAC1C\uB97C \uB354 \uAF3F\uAF3F\uD788 \uC138\uC6B0\uC138\uC694. \uACE7 \uB2E4\uC2DC \uC9D3\uBC1F\uC544 \uC904 \uD14C\uB2C8\uAE4C."
    holdSeconds: 0
    priority: 0
  - trigger: 18
    message: "\uADF8 \uC815\uB3C4\uB85C \uAE30\uBED0\uD560 \uC77C\uC778\uAC00\uC694? \uACE0\uC791 \uD55C \uD310 \uC774\uAE34 \uAC83\uBFD0\uC778\uB370. \uB2F9\uC2E0\uC5D0\uAC8C\uB294 \uADF8\uAC8C \uADF8\uB807\uAC8C \uB300\uB2E8\uD55C \uC77C\uC774\uC5C8\uB098 \uBCF4\uC8E0."
    holdSeconds: 0
    priority: 0
  - trigger: 19
    message: "\uADF8 \uC808\uB9DD\uD558\uB294 \uC5BC\uAD74\u2026 \uC815\uB9D0 \uC544\uB984\uB2F5\uB124\uC694. \uBB50\uB77C\uACE0 \uB354 \uD615\uC6A9\uC744 \uD574\uC57C \uB2F9\uC2E0\uC774 \uB354 \uBE44\uCC38\uD574 \uC9C8\uAE4C\uC694."
    holdSeconds: 0
    priority: 0
  - trigger: 19
    message: "\uB2F9\uC2E0\uC774 \uC548\uC2EC\uD558\uACE0 \uC6C3\uB358 \uADF8 \uC21C\uAC04\uC744, \uB0B4\uAC00 \uC9C1\uC811 \uC9D3\uBC1F\uC558\uAD70\uC694. \uB2E4\uC2DC \uC77C\uC5B4\uC11C\uC2E4 \uC218 \uC788\uC744\uAE4C\uC694?"
    holdSeconds: 0
    priority: 0
  - trigger: 20
    message: "\uD798\uC5C6\uC774 \uBB34\uB108\uC9C0\uB294 \uBAA8\uC2B5\uC774 \uB0B4\uAC00 \uB420 \uC904\uC774\uC57C. \uC774\uB7F0 \uC800\uC758 \uBAA8\uC2B5\uC744 \uBCF8 \uB2F9\uC2E0, \uC55E\uC73C\uB85C\uB3C4 \uC870\uC2EC\uD558\uC138\uC694."
    holdSeconds: 0
    priority: 0
  - trigger: 21
    message: "\uBC8C\uC368 \uB3C4\uB9DD\uAC00\uC2DC\uB824\uACE0\uC694? \uD6C4\uD6C4\u2026 \uB2F9\uC2E0\uC758 \uADF8 \uCD08\uB77C\uD55C \uB4B7\uBAA8\uC2B5, \uAF64 \uB9C8\uC74C\uC5D0 \uB4DC\uB124\uC694."
    holdSeconds: 0
    priority: 0
  - trigger: 21
    message: "\uAC81\uBA39\uACE0 \uAC00\uBC84\uB9AC\uC2E0\uB2E4\uB2C8, \uB2E4\uC74C\uC5D0 \uB610 \uBB34\uB98E \uAFC7\uACE0 \uCC3E\uC544\uC624\uBA74, \uADF8\uB54C\uB294 \uB354 \uC81C\uB300\uB85C \uAC00\uC9C0\uACE0 \uB180\uC544\uB4DC\uB9AC\uC8E0."
    holdSeconds: 0
    priority: 0
  - trigger: 22
    message: "\uBB34\uC2A8 \uC0C1\uC0C1\uC744 \uD558\uC168\uC744\uAE4C\uC694. \uB2F9\uC2E0\uC774 \uC0DD\uAC01\uD55C \uAC74 \uC774\uB904\uC9C0\uC9C0 \uC54A\uC744 \uAC70\uC5D0\uC694."
    holdSeconds: 0
    priority: 0
  - trigger: 22
    message: "\uCD08\uC870\uD558\uAC8C \uB098\uB97C \uBC14\uB77C\uBCF4\uB294 \uADF8 \uB208\uBE5B, \uAF64 \uC990\uAC81\uAD70\uC694. \uC77C\uBD80\uB7EC \uCC9C\uCC9C\uD788 \uB118\uAE30\uBA74\uC11C \uC990\uAE30\uACE0 \uC2F6\uC5B4\uB77C."
    holdSeconds: 0
    priority: 0
  - trigger: 22
    message: "\uC5EC\uAE30\uC11C \uBA48\uCD94\uB294 \uAC74 \uC18C\uC778\uBC30\uB4E4\uC774\uB098 \uD558\uB294 \uC9D3\uC774\uC8E0, \uC800\uB294 \uB300\uAD6D\uC744 \uBC14\uB77C\uBCF4\uACE0 \uC788\uB2F5\uB2C8\uB2E4."
    holdSeconds: 0
    priority: 0
  - trigger: 22
    message: "\uB0B4 \uC190\uB180\uB9BC\uC744 \uC228\uC8FD\uC5EC \uC9C0\uCF1C\uBCF4\uB294 \uADF8 \uBAA8\uC2B5, \uAF64 \uAC00\uB828\uD558\uAD70\uC694. \uC774 \uC815\uB3C4\uC5D0\uB3C4 \uC544\uC9C1 \uD76C\uB9DD\uC744 \uD488\uACE0 \uC788\uB2E4\uB2C8\u2026 \uC6C3\uAE30\uACE0\uB3C4 \uB0A8\uC544\uC694"
    holdSeconds: 0
    priority: 0
  - trigger: 22
    message: "\uC88B\uC740 \uD328\uB294 \uC81C\uAC8C \uC624\uB294 \uAC8C \uB2F9\uC5F0\uD558\uC8E0."
    holdSeconds: 0
    priority: 0
  - trigger: 22
    message: "\uD45C\uC815\uC774 \uC65C \uADF8\uB7EC\uC2DC\uC8E0? \uC124\uB9C8 \uC81C \uD328\uAC00 \uC88B\uC744\uAE4C \uBD10 \uBC8C\uC368 \uAC81\uBA39\uC73C\uC2E0 \uAC74\uAC00\uC694?"
    holdSeconds: 0
    priority: 0
  - trigger: 23
    message: "\uC5EC\uAE30\uC11C \uBA48\uCD94\uC8E0. \uC774\uBBF8 \uC2B9\uBD80\uB294 \uC815\uD574\uC84C\uC5B4\uC694."
    holdSeconds: 0
    priority: 0
  - trigger: 23
    message: "\uBBF8\uB798\uAC00 \uB290\uAEF4\uC838\uC694. \uC5EC\uAE30\uC11C \uBA48\uCDB0\uC57C \uD55C\uB2E4\uB294 \uAC83\uC744"
    holdSeconds: 0
    priority: 0
  - trigger: 24
    message: "\uC81C\uAC90 \uB9CC\uD68C\uD560 \uAE30\uD68C\uB294 \uC5BC\uB9C8\uB4E0\uC9C0 \uC788\uC2B5\uB2C8\uB2E4. \uADF8\uB7F0 \uC5BC\uBE60\uC9C4 \uD45C\uC815\uC740 \uADF8\uB9CC \uC9C0\uC73C\uC2DC\uAE38"
    holdSeconds: 0
    priority: 0
  - trigger: 24
    message: "\uADF8 \uC5BC\uAD74\u2026 \uC815\uB9D0 \uAC00\uB828\uD558\uACE0, \uB610 \uC5ED\uACB9\uB3C4\uB85D \uC9DC\uC99D\uB098\uB124\uC694. \uC774 \uC7A0\uAE50\uC758 \uC5EC\uC720, \uB0B4\uAC00 \uC9C1\uC811 \uB2E4\uC2DC \uBE7C\uC557\uC544 \uC904 \uD14C\uB2C8 \uC81C\uB300\uB85C \uB9CC\uB07D\uD558\uC138\uC694"
    holdSeconds: 0
    priority: 0
  - trigger: 25
    message: "\uD6C4\uD6C4\uD6C4\uD6C4. \uC2B9\uC790\uB294 \uC5B8\uC81C\uB098 \uB098\uC785\uB2C8\uB2E4.\uAC00\uC7A5 \uC544\uB984\uB2E4\uC6B4 \uC7A5\uB09C\uAC10\uC774 \uB418\uC5B4\uC8FC\uC154\uC11C \uAC10\uC0AC\uD574\uC694."
    holdSeconds: 0
    priority: 0
  - trigger: 25
    message: "\uB2F9\uC5F0\uD788 \uC774\uB7F0 \uACB0\uACFC\uAC00 \uB098\uC62C\uC904 \uC54C\uC558\uB294 \uB370\uB3C4 \uC800\uC5D0\uAC8C \uC2E0\uCCAD\uD558\uC2DC\uB2E4\uB2C8. \uC624\uD788\uB7EC \uD63C\uB098\uACE0 \uC2F6\uC5B4\uC11C \uC624\uC2E0\uAC74\uAC00\uC694?"
    holdSeconds: 0
    priority: 0

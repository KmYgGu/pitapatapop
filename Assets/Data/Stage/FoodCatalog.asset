    price: 20
    icon: {fileID: 0}
  - foodId: 13
    displayName: "\uAD74"
    explanation: "\uC601\uC591\uC774 \uB118\uCE58\uB294 \uBC14\uB2E4\uC758 \uC6B0\uC720\uC785\uB2C8\uB2E4. \uB808\uBAAC\uC999\uC744 \uC0B4\uC9DD \uBFCC\uB824\uB3C4 \uC88B\uACE0 \uCA84\uC11C \uBA39\uC5B4\uB3C4 \uB9DB\uC788\uC8E0!"
